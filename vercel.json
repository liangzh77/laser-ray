{
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/index.html", "destination": "/public/index.html" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/test-laser.html", "destination": "/public/test-laser.html" },
    { "source": "/test-laser-v2.html", "destination": "/public/test-laser-v2.html" },
    { "source": "/test-splitter-hit.html", "destination": "/public/test-splitter-hit.html" }
  ],
  "headers": [
    {
      "source": "/src/(.*).js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
