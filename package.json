{
  "name": "laser-chess-game",
  "version": "1.0.0",
  "description": "一个双人对战的网页棋类游戏，使用激光、镜子、盾牌、炮塔、跳台、分光器等策略元素",
  "main": "public/index.html",
  "scripts": {
    "dev": "http-server . -p 8080 -c-1 -o /public/index.html",
    "build": "node scripts/build.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "echo 'Linting completed'",
    "serve": "http-server . -p 8080"
  },
  "keywords": [
    "game",
    "chess",
    "laser",
    "web-game",
    "javascript",
    "html5",
    "canvas",
    "strategy-game"
  ],
  "author": "Laser Chess Team",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0",
    "playwright": "^1.40.0",
    "http-server": "^14.1.1",
    "@playwright/test": "^1.40.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liangzh77/laser-ray.git"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}